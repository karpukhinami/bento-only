# Скопируйте в .env для локальной разработки (файл .env в git не попадает).

# --- AI (нужен хотя бы один путь) ---
# Ключ Lovable AI Gateway — для моделей, которые не идут через OpenRouter
LOVABLE_API_KEY=

# Ключ OpenRouter — для моделей openrouter/* в приложении
OPENROUTER_API_KEY=

# --- Google Archive (опционально; без этого архив/фидбек в Sheets отключён) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_ID=
# GOOGLE_SHEET_NAME=
